{
  "sourceLanguage" : "en",
  "strings" : {
    "%1$@ wants to use %2$@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 직원이 %2$@ 도구를 쓰려고 해요"
          }
        }
      }
    },
    "%lld at work · Updated %@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld명 근무 중 · %@ 업데이트"
          }
        }
      }
    },
    "Allow" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허락"
          }
        }
      }
    },
    "Allowed" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용됨"
          }
        }
      }
    },
    "Allowed: the command runs on your Mac" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허락했어요: Mac에서 명령이 실행돼요"
          }
        }
      }
    },
    "An office where your coding agents work" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코딩 에이전트가 일하는 사무실"
          }
        }
      }
    },
    "Answer permission questions anywhere" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허락 요청은 어디서든 바로"
          }
        }
      }
    },
    "Building" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건물"
          }
        }
      }
    },
    "Commands are end-to-end encrypted and kept only in your own iCloud. Get AgentOffice for Mac from the App Store, and sign in with the same Apple Account on both." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령어는 종단간 암호화되어 내 iCloud에만 저장돼요. App Store에서 Mac용 AgentOffice를 받고, 두 기기에서 같은 Apple 계정으로 로그인하세요."
          }
        }
      }
    },
    "Couldn’t check" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인 못 함"
          }
        }
      }
    },
    "Couldn’t load the office.\nTrying again soon." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사무실 정보를 불러오지 못했어요.\n잠시 후 다시 시도해요."
          }
        }
      }
    },
    "Denied: the command does not run" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거절했어요: 명령이 실행되지 않아요"
          }
        }
      }
    },
    "Deny" : {
      "localizations" : {
        "ko" : {
